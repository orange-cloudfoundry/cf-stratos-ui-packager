#!/usr/bin/env bash
set -euo pipefail

tag="${1:?A release tag is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GITHUB_API_URL:?GITHUB_API_URL is required}"
: "${RUNNER_TEMP:?RUNNER_TEMP is required}"

response="$RUNNER_TEMP/stratos-release.json"
encoded_tag="$(printf '%s' "$tag" | jq -sRr @uri)"
status="$(curl --silent --show-error --location \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: Bearer $GH_TOKEN" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  -o "$response" -w '%{http_code}' \
  "$GITHUB_API_URL/repos/$GITHUB_REPOSITORY/releases/tags/$encoded_tag")"
case "$status" in
  200)
    jq -e '(.draft | type) == "boolean" and (.assets | type) == "array"' "$response" > /dev/null
    if jq -e '.draft == false and any(.assets[]; .name == "stratos-ui.zip" and .state == "uploaded" and .size > 0)' "$response" > /dev/null; then
      echo "Release $tag already contains stratos-ui.zip"
      exit 0
    fi
    echo "Release $tag is incomplete; triggering packaging"
    ;;
  404)
    echo "Release $tag does not exist; triggering packaging"
    ;;
  *)
    echo "Could not check release $tag (HTTP $status)" >&2
    cat "$response" >&2
    exit 1
    ;;
esac
gh workflow run releaser.yml --repo "$GITHUB_REPOSITORY" --ref master -f "release_tag=$tag"
