#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
gh workflow run update-and-tag.yml --repo "$repo" --ref master
echo "Update workflow started for $repo. View its progress with: gh run list --repo $repo --workflow update-and-tag.yml"
